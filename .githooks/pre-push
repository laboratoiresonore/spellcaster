#!/bin/bash
# Phase 11.5b -- HERMES-EDITS-CODE HARD RULE enforcement (2026-07-04, rev 2).
#
# Rejects any push from a `hermes/<yyyymmdd>-<slug>` diff branch unless:
#   1. `_audit/hermes-edits/<slug>.md` (the plan) is present at HEAD
#   2. `_audit/hermes-edits/<slug>-pr-body.md` (the drafted PR body) is present
#   3. There is at least one non-empty test-evidence line in the plan
#
# Also enforces the invariant that Hermes NEVER pushes directly. The rule:
# if the commit author matches a Hermes-owned identity AND the branch
# starts with `hermes/`, the push is BLOCKED and the user is asked to
# route it through a Claude-side audit + push instead.
#
# Non-Hermes-authored pushes (user, Claude) are unaffected.
#
# Activate: `git config --local core.hookspath .githooks`
set -eu

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
HEAD_AUTHOR="$(git log -1 --format='%an <%ae>')"

# ---------------------------------------------------------------------------
# Rule 0: PUBLIC-REPO LEAK GATE (added 2026-07-18, unified 2026-09-24 for #12).
#
# `spellcaster` is a PUBLIC repository. A push here is irreversible publication:
# deleting a commit later does not un-publish it (forks, caches, and the GitHub
# events API keep it). This gate runs on EVERY branch -- not just hermes/* --
# because the branch name is not what makes a leak dangerous.
#
# The pattern list lives in `.githooks/leak-patterns`; the same file is read by
# `.githooks/pre-commit` and `.github/workflows/leak-check.yml`, so edits stay
# in sync across all three scanners. If the file is missing (shallow checkout
# / corrupt tree / user removed it), a hard-coded fallback is used and a
# warning is emitted -- the hook is defensive, never silent.
# ---------------------------------------------------------------------------
_LEAK_PATTERN_FILE=".githooks/leak-patterns"

# Fallback patterns -- an inline duplicate of leak-patterns for the case where
# the file is absent. Keep this in sync with `.githooks/leak-patterns` on any
# edit; the file is the source of truth, this fallback is a safety net.
_FALLBACK_SECRET='ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|ghs_[A-Za-z0-9]{20,}|ghu_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{40,}|hf_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}'
# NOTE: `-i` is passed at the call site; do not use `(?i)` (invalid ERE).
_FALLBACK_CRED='(password|passwd|secret|api_key|apikey|token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'{$<]{8,}["'"'"']'
_FALLBACK_PII='leguillaume|lmlgg|@gmail\.com|MASTER_PLAN|192\.168\.86\.(31|23|77|219)|192\.168\.0\.100'

# _section_regex FILE SECTION -- emit the `|`-joined regex for one section of
# the pattern file. SECTION is one of: credentials, PII, internal identifiers.
_section_regex() {
  local file="$1"
  local want="$2"
  awk -v want="$want" '
    /^#/ {
      line = $0
      sub(/^#[ \t]+/, "", line)
      sub(/[ \t]+$/, "", line)
      if (line == "credentials" || line == "PII" || line == "internal identifiers") {
        in_section = (line == want)
      }
      next
    }
    /^[[:space:]]*$/ { next }
    in_section { print }
  ' "$file" | tr '\n' '|' | sed 's/|$//'
}

_load_leak_patterns() {
  if [ -r "$_LEAK_PATTERN_FILE" ]; then
    pat_credentials="$(_section_regex "$_LEAK_PATTERN_FILE" 'credentials')"
    pat_pii="$(_section_regex "$_LEAK_PATTERN_FILE" 'PII')"
    pat_internal="$(_section_regex "$_LEAK_PATTERN_FILE" 'internal identifiers')"
    if [ -n "$pat_credentials" ] && [ -n "$pat_pii" ] && [ -n "$pat_internal" ]; then
      return 0
    fi
    echo "[pre-push] warning: $_LEAK_PATTERN_FILE parsed empty for one or more sections; using built-in fallback" >&2
  else
    echo "[pre-push] warning: $_LEAK_PATTERN_FILE missing; using built-in fallback (patterns may drift)" >&2
  fi
  # Fallback: the credential idiom joins pat_secret's tokens because the
  # unified file combines them under `# credentials`; do the same here.
  pat_credentials="$_FALLBACK_SECRET|$_FALLBACK_CRED"
  pat_pii="leguillaume|lmlgg|@gmail\\.com"
  pat_internal='MASTER_PLAN|192\.168\.86\.(31|23|77|219)|192\.168\.0\.100'
}

_leak_scan() {
  local range="$1"
  local added
  added="$(git diff --unified=0 "$range" 2>/dev/null | grep '^+' | grep -v '^+++' || true)"
  [ -z "$added" ] && return 0

  local pat_credentials pat_pii pat_internal
  _load_leak_patterns

  local hits hits2 hits3
  hits="$(printf  '%s\n' "$added" | grep -nEi "$pat_credentials" || true)"
  hits2="$(printf '%s\n' "$added" | grep -nEi "$pat_pii"         || true)"
  hits3="$(printf '%s\n' "$added" | grep -nE  "$pat_internal"    || true)"

  if [ -n "$hits$hits2$hits3" ]; then
    echo "=================================================================" >&2
    echo "  pre-push BLOCKED: possible secret / personal data in a PUBLIC repo" >&2
    echo "=================================================================" >&2
    [ -n "$hits"  ] && { echo "  [credentials]"          >&2; printf '%s\n' "$hits"  | head -5 | cut -c1-160 >&2; }
    [ -n "$hits2" ] && { echo "  [PII]"                  >&2; printf '%s\n' "$hits2" | head -5 | cut -c1-160 >&2; }
    [ -n "$hits3" ] && { echo "  [internal identifiers]" >&2; printf '%s\n' "$hits3" | head -5 | cut -c1-160 >&2; }
    echo "" >&2
    echo "  spellcaster is PUBLIC. Publication is NOT reversible by deleting" >&2
    echo "  the commit later. Sanitize, or override deliberately with:" >&2
    echo "    SKIP_PUBLIC_LEAK_GATE=1 git push ..." >&2
    echo "  If a real credential already left this machine, ROTATE IT FIRST." >&2
    echo "=================================================================" >&2
    return 1
  fi
  return 0
}

if [ "${SKIP_PUBLIC_LEAK_GATE:-0}" != "1" ]; then
  _ZERO=0000000000000000000000000000000000000000
  while read -r _lref _lsha _rref _rsha; do
    [ -z "${_lsha:-}" ] && continue
    # Local all-zeros = branch DELETION -> nothing being published, skip.
    [ "$_lsha" = "$_ZERO" ] && continue

    if [ "${_rsha:-$_ZERO}" != "$_ZERO" ] && git cat-file -e "$_rsha" 2>/dev/null; then
      # Updating an existing remote branch: scan only the new commits.
      _range="${_rsha}..${_lsha}"
    else
      # NEW remote branch (remote sha is all zeros). This is the HIGHEST-risk
      # case, not a skip -- the original logic inverted this and let a planted
      # ghp_ token through on a fresh branch. Scan everything this branch adds
      # that is not already on the default branch.
      _base="$(git merge-base "$_lsha" origin/main 2>/dev/null                || git merge-base "$_lsha" main 2>/dev/null || true)"
      if [ -n "$_base" ]; then
        _range="${_base}..${_lsha}"
      else
        _range="$_lsha"
      fi
    fi
    _leak_scan "$_range" || exit 1
  done
fi

# Only enforce the HERMES-EDITS-CODE stages on hermes/* branches
case "$BRANCH" in
  hermes/*) ;;
  *) exit 0 ;;
esac

# Rule 1: block direct pushes by any actor whose identity matches Hermes-owned.
# Hermes-owned identities: contains "hermes" or "Hermes" or the specific
# hermes-agent no-reply address. Extend if your fleet uses others.
case "$HEAD_AUTHOR" in
  *hermes*|*Hermes*|*hermes-agent*|*noreply@anthropic.com*)
    cat >&2 <<EOF
[pre-push] BLOCKED: Hermes-authored commit on hermes/* branch.

Author: $HEAD_AUTHOR
Branch: $BRANCH

Per HERMES-EDITS-CODE HARD RULE (\`~/.claude/CLAUDE.md\`, rev 2, 2026-07-04):
Hermes commits but NEVER pushes. Push happens only after Claude's deep-audit
pass on the local commits.

Route the push through a Claude session:
  1. Ask Claude to review the branch: \`git log $BRANCH ^main --stat\`
  2. Claude runs the audit checklist (PII / SFW-NSFW / secret-file / plan coverage)
  3. Claude decides push vs revert
  4. Claude pushes iff clean

To bypass this hook (Claude-authored push, post-audit): commit under a
non-Hermes author identity OR use \`git push --no-verify\` (audit trail
is on you).
EOF
    exit 1
    ;;
esac

# Rule 2: plan doc + PR body drafted
SLUG="${BRANCH#hermes/}"
# Strip repo prefix if branch shape is hermes/<repo>/<date>-<slug>
case "$SLUG" in
  */*) SLUG="${SLUG##*/}" ;;
esac
PLAN="_audit/hermes-edits/${SLUG}.md"
PR_BODY="_audit/hermes-edits/${SLUG}-pr-body.md"

if [ ! -f "$PLAN" ]; then
  echo "[pre-push] BLOCKED: missing plan doc at $PLAN" >&2
  echo "[pre-push] per HERMES-EDITS-CODE Stage 3, every hermes/* branch needs a plan file" >&2
  exit 2
fi

if [ ! -f "$PR_BODY" ]; then
  echo "[pre-push] BLOCKED: missing PR body at $PR_BODY" >&2
  echo "[pre-push] per HERMES-EDITS-CODE Stage 8, Claude drafts PR body locally before pushing" >&2
  exit 3
fi

# Rule 3: at least one non-comment, non-empty evidence line
# (either a checked box, a 'PASS' marker, or a test-run reference)
if ! grep -qE '^\s*(- \[x\]|PASS:|\*\*evidence\*\*:|running:)' "$PLAN"; then
  echo "[pre-push] BLOCKED: no test-evidence line in $PLAN" >&2
  echo "[pre-push] per HERMES-EDITS-CODE Stage 5, plan must record at least one PASSED test" >&2
  exit 4
fi

exit 0
