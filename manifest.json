          {"path": "checkpoints/SDXL/Base/AlbedoBaseXL.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL — AlbedoBase XL"},
          {"path": "checkpoints/SDXL/Base/sd_xl_base_1.0.safetensors", "url": "https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0/resolve/main/sd_xl_base_1.0.safetensors", "size_mb": 6938, "optional": true, "note": "SDXL — Official base model"},
          {"path": "checkpoints/SDXL/Cartoon-3D/modernDisneyXL_v3.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Cartoon — Modern Disney XL"},
          {"path": "checkpoints/SDXL/Cartoon-3D/novaCartoonXL_v60.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Cartoon — Nova Cartoon XL"},
          {"path": "checkpoints/SDXL/Realistic/cyberrealisticPony_v160.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Realistic — CyberRealistic Pony"},
          {"path": "checkpoints/SDXL/Realistic/jibMixRealisticXL_v180SkinSupreme.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Realistic — JibMix Realistic XL"},
          {"path": "checkpoints/SDXL/Realistic/juggernautXL_ragnarok.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Realistic — Juggernaut XL Ragnarok"},
          {"path": "checkpoints/SDXL/Realistic/juggernautXL_v9Rundiffusionphoto2.safetensors", "url": "https://civitai.com/api/download/models/456194", "size_mb": 6938, "optional": true, "note": "SDXL Realistic — Juggernaut XL v9"},
          {"path": "checkpoints/SDXL/Realistic/zavychromaxl_v100.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Realistic — ZavyChroma XL"},
          {"path": "checkpoints/Illustrious/ilustreal_v50VAE.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "Illustrious — IlustrReal v5"},
          {"path": "checkpoints/Illustrious/sloppyMessyMix_sloppyMessyMixV1.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "Illustrious — Sloppy Messy Mix"}
        ],
        "note": "You need at least ONE checkpoint. Recommended starter: juggernautXL_v9Rundiffusionphoto2 (SDXL Realistic)."
      },
      "custom_nodes": ["ComfyUI_GetImageSize"]
    },

    "txt2img": {
      "label": "Text-to-Image Generation",
      "description": "Generate images from text prompts (GIMP only)",
      "plugins": ["gimp"],
      "models": {
        "note": "Uses same checkpoints as img2img — no additional models needed."
