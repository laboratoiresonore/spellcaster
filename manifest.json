      "description": "Generate images from source images using SD 1.5, SDXL, Illustrious, and Klein Flux2 models",
      "plugins": ["gimp", "darktable"],
      "models": {
        "checkpoints": [
          {"path": "checkpoints/SD-1.5/juggernaut_reborn.safetensors", "url": "https://civitai.com/api/download/models/274039", "size_mb": 2013, "optional": true, "note": "SD 1.5 — Juggernaut Reborn"},
          {"path": "checkpoints/SD-1.5/realisticVisionV51_v51VAE.safetensors", "url": "https://civitai.com/api/download/models/130072", "size_mb": 2013, "optional": true, "note": "SD 1.5 — Realistic Vision v5.1"},
          {"path": "checkpoints/SD-1.5/v1-5-pruned-emaonly.safetensors", "url": "https://huggingface.co/stable-diffusion-v1-5/stable-diffusion-v1-5/resolve/main/v1-5-pruned-emaonly.safetensors", "size_mb": 4265, "optional": true, "note": "SD 1.5 — Base model"},
          {"path": "checkpoints/SDXL/Anime/NoobAI-XL-v1.1.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Anime — NoobAI XL"},
          {"path": "checkpoints/SDXL/Anime/novaAnimeXL_ilV170.safetensors", "url": null, "size_mb": 6938, "optional": true, "note": "SDXL Anime — Nova Anime XL"},
