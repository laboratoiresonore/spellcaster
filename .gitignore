# Build artifacts
build/
dist/
*.spec
*.spec.bak

# Virtual environments (created by build scripts)
.build-venv/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
*.egg

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linters / formatters
.ruff_cache/

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary files
*.tmp
*.bak
*.swp
*~

# Compiled installers at root (built from installer/ dir, too large for git)
*.exe

# Loose test images at root
selfie*.png

# User data — personal presets, session state, config
user_presets.json
session_state.json
config.json
*.spellcaster_version

# Generated content — ignore all video/gif except assets/ gifs
*.mp4
*.gif
!assets/*.gif
!assets/**/*.gif

# Signal Bridge — machine-specific config with IPs, API keys, paths
signal_bridge_config.json
signal_bridge_*.log

# Machine-specific settings — never commit local network config
local_settings.json
.env
.env.*

# NSFW builds — never push to public repo
nsfw/
*_nsfw*
manifest_nsfw.json

# Guild runtime state (user-generated, not distributable)
.guild_version
guild_config.json
tavern/.guild_state/
tavern/characters/*.png
tavern/guild_config.json
tavern/.guild_version
