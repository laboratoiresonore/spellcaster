__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# NSFW Content — NEVER commit
nsfw/
*_NSFW.*
*_nsfw.*
*nsfw*
Wizard_Guild_NSFW.exe

# User-generated content — never commit (could contain NSFW images)
tavern/creations/
tavern/.guild_state/
tavern/.guild_version

# Large binaries — go to GitHub Releases, not git
*.exe
*.dmg
*.pkg
*.app/
Wizard_Guild.exe
spellcaster-installer.exe
spellcaster-manual-update.exe

# Machine-specific runtime files (contain local paths, server IPs)
guild_config.json
tavern/guild_config.json
signal_bridge_config.json
.guild_version
rebuild.bat
push_*.bat
DEVNOUPDATE*.bat

# User-generated state (avatars, session data, timestamps)
.guild_state/
generated_assets.json
session_state.json
user_presets.json
config.json

# Claude Code internal files
.claude/
.mcp.json

# Per-session handover docs — contain real LAN IPs and local paths,
# intended for Claude-to-Claude orchestration, never for the public repo
HANDOVER_*.md

# CLAUDE.md — dev-guide for Claude, kept local. Contains project-specific
# instructions + paths/tokens referenced contextually. Every contributor
# maintains their own.
CLAUDE.md

# Gemini MCP output
gemini-output/

# Dev tools & scratch files
tools/generate_readme_gifs.py
test_live.py
test_guild.py
tests/*
# carve-outs: canonical shared harnesses (per-dev scratch tests stay
# ignored; whitelist the files that should travel with the repo)
!tests/e2e_audit.py
!tests/e2e_report.md
!tests/test_klein_enhancer.py
!tests/test_quality_boost.py
!tests/test_model_prompt_profiles.py
!tests/test_lora_auto_calibrate.py
audit_*.py

# Spell icons (user-generated during install, not source)
assets/spells/

# IDE / editor
.vscode/
.idea/
*.swp
*~

# Temp files
*.tmp
*.bak
*.update
*.orig

# Canon animated-avatar bake tooling — outputs get committed into
# tavern/default_assets/, but the script itself is dev-only and would
# only clutter the public repo.
tools/bake_canon_animated_avatars.py

